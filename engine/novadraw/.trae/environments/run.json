{
  "version": 1,
  "defaultActionId": "composite-shapes-screenshot",
  "actions": [
    {
      "id": "composite-shapes-screenshot",
      "name": "Composite Shapes 截图验证",
      "command": "cargo run -p composite-shapes-app -- --screenshot",
      "cwd": ".",
      "background": false,
      "source": "agent",
      "open": {
        "type": "terminal"
      }
    },
    {
      "id": "gef-shapes-macos",
      "name": "GEF Shapes 编辑器（macOS）",
      "command": "python3 tools/scripts/run_gef_macos.py",
      "cwd": ".",
      "background": true,
      "source": "agent",
      "open": {
        "type": "terminal"
      }
    },
    {
      "id": "gef-logic-macos",
      "name": "GEF Logic 编辑器（macOS）",
      "command": "python3 tools/scripts/run_gef_macos.py --demo logic",
      "cwd": ".",
      "background": true,
      "source": "agent",
      "open": {
        "type": "terminal"
      }
    },
    {
      "id": "draw2d-official-macos",
      "name": "Draw2D 官方样例（macOS）",
      "command": "python3 tools/scripts/run_draw2d_macos.py",
      "cwd": ".",
      "background": true,
      "source": "agent",
      "open": {
        "type": "terminal"
      }
    },
    {
      "id": "textflow-large-macos",
      "name": "TextFlowLarge 性能研究（macOS）",
      "command": "python3 tools/scripts/run_textflow_large_macos.py --release --clt --target-dir /tmp/novadraw-text-stage-target -- --text-raster-cache --natural-damage --output target/verification/textflow-raster-interactive",
      "cwd": ".",
      "background": true,
      "source": "agent",
      "open": {
        "type": "terminal"
      }
    }
  ]
}
