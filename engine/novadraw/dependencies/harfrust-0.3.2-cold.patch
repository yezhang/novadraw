+        let table_offsets = TableOffsets::new_with(font, policy)?;
+        // cmap_cache_t is an inline hb_cache_t of 256 atomics.
+        policy.charge(ColdOperation::Initialize, cmap_cache_t::INLINE_SLOTS, 0)?;
+        let cmap_cache = cmap_cache_t::new();
+        Ok(Some(Self {
+            table_offsets,
+            ot_cache,
+            aat_cache,
+            cmap_cache,
+        }))
+    }
 
