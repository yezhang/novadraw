+    pub fn try_new_admitted<E>(
+        font: &FontRef,
+        admit: impl FnMut(ColdOperation, ColdOperationCost) -> Result<(), E>,
+    ) -> Result<Option<Self>, ColdOperationError<E>> {
+        let policy = &mut cold_admission::AdmittedCold(admit);
