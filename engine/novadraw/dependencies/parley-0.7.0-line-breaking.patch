+impl<B: Brush + Copy> Layout<B> {
+    /// Break all lines of an owned candidate after incremental caller admission.
+    ///
+    /// On rejection or reservation failure the candidate is consumed and no
+    /// partially broken layout escapes. Drop releases buffers without the
+    /// usual final dimension scan. Success explicitly admits that scan before
+    /// returning this layout. An independently retained template is unchanged.
+    ///
+    /// Item/cluster loops charge each visit, including boundary rollback and
+    /// ligature probes. Commit and metric scans admit source-derived upper
+    /// bounds; bidi reordering charges each actual level separately. Only the
+    /// line and line-item arrays grow; growth uses fallible exact reservations
+    /// and a geometric capacity policy. Work includes potential relocation of
+    /// initialized elements, and allocation conservatively charges the entire
+    /// new capacity, not just its increment. Unused admitted cost is not refunded.
+    /// Exact logical capacity relies on the same Global Vec/toolchain contract
+    /// as `try_clone_admitted`. Allocator bookkeeping and physical rounding
+    /// are excluded. This entry does not certify analysis or shaping.
+    pub fn try_break_all_lines_admitted<E>(
+        mut self,
+        max_advance: Option<f32>,
+        mut admit: impl FnMut(LayoutOperation, LayoutOperationCost) -> Result<(), E>,
+    ) -> Result<Self, LayoutOperationError<E>> {
+        // Ordinary break_lines first undoes justification. The existing
+        // admitted align entry bounds that mutation, using Start only because
+        // the old lines are immediately discarded.
+        if self.data.is_aligned_justified {
+            self.try_align_admitted(
+                None,
+                super::Alignment::Start,
+                super::AlignmentOptions::default(),
+                &mut admit,
+            )?;
+        }
+        let mut meter = Admitted(admit);
+        {
+            let mut breaker = BreakLines::new(&mut self);
+            breaker.finalize_on_drop = false;
+            while breaker
+                .break_next_impl(max_advance.unwrap_or(f32::MAX), &mut meter)?
+                .is_some()
+            {}
+            scan(
+                &mut meter,
+                LayoutOperation::LineFinalize,
+                breaker.lines.lines.len(),
+                1,
+            )?;
+            // Match finish()'s empty-text normalization before publication.
+            if breaker.layout.data.text_len == 0 {
+                scan(&mut meter, LayoutOperation::LineFinalize, 1, 1)?;
+                if let Some(line) = breaker.lines.line_items.first_mut() {
+                    line.text_range = 0..0;
+                    line.cluster_range = 0..0;
+                }
+            }
+            breaker.finalize();
+        }
+        Ok(self)
+    }
+}
