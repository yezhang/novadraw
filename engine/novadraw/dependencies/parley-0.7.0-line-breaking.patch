+#[cfg(test)]
+mod admission_tests {
+    use super::*;
+
+    #[test]
+    fn rejected_finalization_drops_without_scanning_or_publishing() {
+        let mut layout = Layout::<usize>::new();
+        {
+            let mut breaker = BreakLines::new(&mut layout);
+            breaker.finalize_on_drop = false;
+            // A sentinel that would propagate into layout dimensions if Drop
+            // called the ordinary finalization scan.
+            breaker.lines.lines.push(LineData {
+                metrics: LineMetrics {
+                    advance: 123.0,
+                    line_height: 45.0,
+                    ..Default::default()
+                },
+                ..Default::default()
+            });
+            let mut meter = Admitted(|_, _| Err::<(), _>("refused"));
+            assert!(matches!(
+                scan(&mut meter, LayoutOperation::LineFinalize, 1, 1),
+                Err(LayoutOperationError::Admission("refused"))
+            ));
+        }
+        assert_eq!(layout.data.width, 0.0);
+        assert_eq!(layout.data.height, 0.0);
+        assert!(layout.data.lines.is_empty());
+    }
+
+    #[test]
+    fn ordinary_drop_still_finalizes_partial_lines() {
+        let mut layout = Layout::<usize>::new();
+        {
+            let mut breaker = BreakLines::new(&mut layout);
+            breaker.lines.lines.push(LineData {
+                metrics: LineMetrics {
+                    advance: 123.0,
+                    line_height: 45.0,
+                    ..Default::default()
+                },
+                ..Default::default()
+            });
+        }
+        assert_eq!(layout.data.width, 123.0);
+        assert_eq!(layout.data.height, 45.0);
+        assert_eq!(layout.data.lines.len(), 1);
+    }
