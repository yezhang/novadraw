+enum Condition {
+    Subtag(&'static str),
+    Exact(&'static str),
+    Language(&'static str),
+    Both(&'static str, &'static str),
+}
+
+struct Rule {
+    condition: Condition,
+    tags: &'static [&'static [u8; 4]],
+}
+
+macro_rules! condition {
+    (subtag $a:literal) => {
+        Condition::Subtag($a)
+    };
+    (exact $a:literal) => {
+        Condition::Exact($a)
+    };
+    (lang $a:literal) => {
+        Condition::Language($a)
+    };
+    (both $a:literal / $b:literal) => {
+        Condition::Both($a, $b)
+    };
+}
+
+macro_rules! rules {
+    ($($kind:ident $a:literal $(/ $b:literal)? => [$($tag:literal),+],)*) => {
+        &[$(Rule {
+            condition: condition!($kind $a $(/ $b)?),
+            tags: &[$($tag),+],
+        }),*]
+    };
+}
