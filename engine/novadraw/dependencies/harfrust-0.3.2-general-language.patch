+fn language_equal_with<P: ColdAdmission>(
+    a: &str, b: &str, policy: &mut P,
+) -> Result<bool, P::Error> {
+    policy.charge(ColdOperation::Planning, 2, 0)?;
+    if a.len() != b.len() {
+        return Ok(false);
+    }
+    policy.charge(ColdOperation::TableRead, a.len(), 0)?;
+    policy.charge(ColdOperation::TableRead, b.len(), 0)?;
+    Ok(a == b)
+}
