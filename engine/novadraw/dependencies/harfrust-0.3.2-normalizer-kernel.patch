+    fn original_sort(buffer: &mut hb_buffer_t, start: usize, end: usize) {
+        for i in start + 1..end {
+            let mut j = i;
+            while j > start
+                && buffer.info[j - 1].modified_combining_class()
+                    > buffer.info[i].modified_combining_class()
